#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
selection="$(mktemp "${TMPDIR:-/tmp}/mine-working-tests.XXXXXX.gradle")"
trap 'rm -f "$selection"' EXIT
# Kotest 6.0.7 requires filtered class discovery (see test-mine-lift).
cat > "$selection" <<'GRADLE'
allprojects {
    tasks.withType(Test).configureEach {
        include '**/MineWorking*Test*.class'
        include '**/MineConfigTest*.class'
        include '**/ArcFarmsCompletionTest*.class'
        include '**/ArcFarmsListenerSignatureTest*.class'
        include '**/MineCompactMineAcceptanceTest*.class'
        include '**/MineDrillSceneMockBukkitTest*.class'
        include '**/MineOreWorkshopControllerMockBukkitTest*.class'
        include '**/MineLocationsTest*.class'
        include '**/MineLocationRepositoryTest*.class'
        include '**/MineModuleRecoveryMigrationMockBukkitTest*.class'
        include '**/MineLostMinerMaze*Test*.class'
        include '**/MineConstructionIncidentsMockBukkitTest*.class'
        include '**/MineEntityIncidentsMockBukkitTest*.class'
        include '**/MineWorldIncidentsMockBukkitTest*.class'
        include '**/MineWorldWarmupMockBukkitTest*.class'
        include '**/WorksiteCoherentNoiseTest*.class'
        include '**/WorksiteGuidancePresenterMockBukkitTest*.class'
        include '**/ArcFarmsArchitectureContractTest*.class'
        include '**/MineIncidentCadenceTest*.class'
        include '**/WorksitePreparedSceneOwnerMockBukkitTest*.class'
        include '**/WorksiteExpeditionTravelTest*.class'
        include '**/FarmMoleBurrowWorldMockBukkitTest*.class'
        include '**/ArcFarmsLocaleHotReloadTest*.class'
        include '**/MineShiftV2Test*.class'
        include '**/FarmEventTypeRegistryTest*.class'
    }
}
GRADLE
./gradlew test --init-script "$selection" --console=plain "$@"
